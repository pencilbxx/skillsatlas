    <bpmn:categoryValue id="Cat_Questions" value="2 · QUESTIONING" />
    <bpmn:categoryValue id="Cat_Routes" value="3 · TWO ROUTES" />
    <bpmn:categoryValue id="Cat_Board" value="4 · LEAVE WITH THE BOARD" />
  </bpmn:category>
